<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a href="{{ '/' | absoluteUrl }}" class="brand" aria-label="{{ site.shortName }} — home" style="margin-bottom: var(--s-3);">
          {% set logoClass = "brand__logo" %}{% set decorative = true %}{% include "partials/logo.njk" %}
          <span class="brand__name">{{ site.shortName }}</span>
        </a>
        <p style="margin-top: var(--s-3); max-width: 30ch;">{{ site.tagline }}</p>
      </div>

      {% for s in sections %}
      <div>
        <h3>{{ s.short }}</h3>
        <ul>
          <li><a href="{{ s.url | absoluteUrl }}">Overview</a></li>
          {% set kids = collections.allPages | childrenOf(s.url) %}
          {% for k in kids %}
            <li><a href="{{ k.url | absoluteUrl }}">{{ k.data.shortTitle or (k.url.split('/').slice(-2, -1)[0] | titleize) }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>

    <div class="site-footer__bottom">
      <span>© {{ "" | year }} {{ site.shortName }}. Built with 11ty.</span>
      <span class="site-footer__links">
        <a href="{{ '/' | absoluteUrl }}">Home</a>
        {% for s in sections %} · <a href="{{ s.url | absoluteUrl }}">{{ s.short }}</a>{% endfor %}
        <a class="site-footer__gh" href="https://github.com/cad-gis-bim-interop" rel="noopener" aria-label="{{ site.shortName }} source on GitHub" title="View the source on GitHub">
          <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.01.44-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
        </a>
      </span>
    </div>
  </div>
</footer>
